{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] },
    "outDir": "./dist",
    "rootDir": "./",
    "noEmitOnError": true
  },
  "include": ["**/*.ts"],  
  "exclude": ["node_modules", "../../frontend"] 
}