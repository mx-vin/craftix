# ------------------------------
# Register a new user
# ------------------------------
POST http://localhost:3000/backend/api/auth
Content-Type: application/json
Accept: application/json

{
  "email": "bob@example.com",
  "username": "bob",
  "password": "345",
  "register": true
}

###

# ------------------------------
# Login existing user
# ------------------------------
POST http://localhost:3000/backend/api/auth
Content-Type: application/json
Accept: application/json

{
  "email": "alice@example.com",
  "password": "123",
  "register": false
}

###

# ------------------------------
# Example: failed login (wrong password)
# ------------------------------
POST http://localhost:3000/backend/api/auth
Content-Type: application/json
Accept: application/json

{
  "email": "alice@example.com",
  "password": "wrongpassword",
  "register": false
}