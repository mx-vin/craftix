{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",                  // Required for frontend bundler
    "moduleResolution": "NodeNext",      // NodeNext for ES modules
    "jsx": "react-jsx",                  // React 18 JSX transform
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["frontend/*"]              // frontend alias
    },
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "frontend/**/*",
    "*.ts",
    "*.tsx",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "backend",
    ".next"
  ]
}