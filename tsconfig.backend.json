{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",                 // Node runtime modules
    "moduleResolution": "Node16",       // Node module resolution
    "allowJs": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,               // Avoid TS errors from node_modules
    "baseUrl": ".",
    "paths": {
      "@/*": ["backend/*"]              // Keep imports relative to backend folder
    },
    "types": ["node"]
  },
  "include": [
    "backend/**/*",
    "*.ts",
    "*.tsx",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "frontend",
    ".next"
  ]
}